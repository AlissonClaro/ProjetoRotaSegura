CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE CLIENTES(CPF VARCHAR(20) NOT NULL PRIMARY KEY,NOME VARCHAR(120) NOT NULL,TELEFONE VARCHAR(30) NOT NULL)
CREATE MEMORY TABLE VEICULOS(PLACA VARCHAR(12) NOT NULL PRIMARY KEY,MARCA VARCHAR(80),MODELO VARCHAR(80),ANO INTEGER,CATEGORIA VARCHAR(15),DISPONIVEL BOOLEAN NOT NULL)
CREATE MEMORY TABLE LOCACOES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CPF VARCHAR(20) NOT NULL,PLACA VARCHAR(12) NOT NULL,DIAS INTEGER NOT NULL,TOTAL DECIMAL(12,2),STATUS VARCHAR(15),ABERTURA TIMESTAMP,FECHAMENTO TIMESTAMP,CONSTRAINT SYS_CT_51 CHECK(LOCACOES.DIAS>0),CONSTRAINT SYS_FK_52 FOREIGN KEY(CPF) REFERENCES CLIENTES(CPF),CONSTRAINT SYS_FK_53 FOREIGN KEY(PLACA) REFERENCES VEICULOS(PLACA))
ALTER TABLE LOCACOES ALTER COLUMN ID RESTART WITH 0
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
